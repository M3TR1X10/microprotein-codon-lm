{
  "schema_version": "gap-evaluation-v1",
  "stage": "prospective_held_out_gap_evaluation",
  "scope_config": "configs/secondary/biology.json",
  "training_plan": "reports/secondary/plan.json",
  "required_checkpoint_audit": "reports/secondary/checkpoints.json",
  "protocol": "docs/gap-evaluation-protocol.md",
  "freeze_before_biological_inference": true,
  "exclude_training_cohorts": [
    "data/processed/cohort.jsonl",
    "data/processed/secondary/human_atp8/cohort.jsonl",
    "data/processed/secondary/human_complex/cohort.jsonl",
    "data/processed/secondary/mammal_complex/cohort.jsonl",
    "data/processed/secondary/vertebrate_complex/cohort.jsonl",
    "data/processed/secondary/full_vertebrate/cohort.jsonl"
  ],
  "panel": {
    "max_sequences": 96,
    "max_per_family_taxon": 16,
    "selection_seed": 20260926,
    "selection": "sha256_ranked_stratum_round_robin",
    "exclude_linked_training_parent_records": true,
    "empty_strict_holdout": "report_infeasible_without_substitution"
  },
  "primary": {
    "model_role": "matched",
    "require_completed_final_updates": 2000,
    "model_seeds": [17, 29, 43],
    "gap_codons": [1, 2, 4, 8, 16],
    "gap_seed": 20260927,
    "anchors_per_sequence": 1,
    "anchor_rule": "same_start_with_16_sense_codons_available",
    "exclude_initiation_and_terminal_stop": true,
    "left_context_codons": "full",
    "probability_metric": "joint_gap_bits_per_base_teacher_forced",
    "generation": "codon_synchronous_greedy",
    "codon_joint_probabilities": "exact_64",
    "temperature": 1.0,
    "vocabulary": "all_64_unconstrained",
    "tie_break": "frozen_vocabulary_order"
  },
  "focused_context": {
    "max_sequences": 16,
    "family": "ATP8",
    "tax_id": 9606,
    "require_primary_panel_membership": true,
    "arms": ["human_atp8_base", "human_atp8_codon", "vertebrate_complex_codon"],
    "model_seeds": [17, 29, 43],
    "gap_codons": [1, 2, 4, 8, 16],
    "left_context_codons": [1, 2, 4, 8, 16, 32, "full"],
    "minimum_available_left_codons": 32,
    "minimum_available_right_after_gap16_codons": 8,
    "position_policy": "preserve_absolute_nucleotide_coordinates",
    "initial_context_only": true,
    "anchors_per_sequence": 1,
    "gap_seed": 20260928
  },
  "right_flank": {
    "panel": "focused_context",
    "left_context_codons": [8, "full"],
    "right_context_codons": [0, 1, 2, 4, 8],
    "gap_codons": [1, 2, 4, 8, 16],
    "candidate_method": "prefix_only_codon_synchronous_beam",
    "beam_width": 8,
    "beam_widths": [8, 16],
    "bank_frozen_before_suffix_scoring": true,
    "reuse_bank_across_right_lengths": true,
    "score": "log_p_candidate_given_left_plus_log_p_right_given_left_candidate",
    "length_normalization": false,
    "genetic_code_mask": false,
    "truth_injection": false,
    "report_candidate_recall": true,
    "matched_control": "right_0_same_bank"
  },
  "baselines": {
    "fit_data": "each_model_own_frozen_training_cohort",
    "codon_classes": 64,
    "prior_total_mass": 2.0,
    "methods": ["uniform", "unigram", "bigram", "position", "privileged_family_taxon_position"],
    "fallback": ["pooled_position", "pooled_unigram"],
    "shared_joint_probabilities_across_tokenizers": true
  },
  "diagnostics": {
    "common_conservation_reference": "union_of_all_excluded_training_cohorts",
    "rare_observed_allele_max_frequency": 0.01,
    "separate_unseen_alleles": true,
    "majority_alleles_include_ties": true,
    "within_gap_error_trajectory": true,
    "translation_tables": [1, 2],
    "internal_stop_repair": false
  },
  "uncertainty": {
    "display_each_model_seed": true,
    "replication_unit": "distinct_cds",
    "bootstrap_iterations": 2000,
    "bootstrap_seed": 20260929,
    "cluster_identity_threshold": 0.99,
    "cluster_within": ["family", "tax_id", "length_nt"],
    "minimum_clusters_per_contributing_stratum_for_band": 5,
    "paired_conditions": true,
    "biological_population_claim": false
  },
  "exploratory": {
    "gap_codons": [32, 48, 64],
    "long_gap_rule": "same_primary_anchor_if_gap_length_sense_codons_available",
    "long_gap_compare_on_support_intersection": true,
    "full_pool_arm": "full_vertebrate_capacity",
    "full_pool_seed": 17,
    "exclude_full_pool_from_matched_causal_contrasts": true
  },
  "runtime": {
    "max_seconds": 5400,
    "device": "cpu",
    "cpu_threads": 4,
    "interop_threads": 1,
    "precision": "float32",
    "concurrent_with_training": false,
    "synthetic_profile_before_plan_freeze": true,
    "priority": ["primary", "focused_context", "right_flank", "exploratory"],
    "order": "frozen_training_job_order_then_frozen_case_order",
    "checkpoint_loading": "one_at_a_time",
    "save_complete_cases_on_budget_stop": true,
    "retain_partial_and_missing_cells": true
  }
}
